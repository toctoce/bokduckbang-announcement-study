# 관리자 API 요청에 사용하는 선택적 브라우저 공개 URL입니다.
# 값이 없으면 로컬 개발은 http://localhost:8080, 프로덕션은 같은 주소의 /api를 사용합니다.
# 별도 API 주소가 필요할 때만 끝 슬래시 없이 설정합니다.
VITE_API_BASE_URL=

# NAVER Maps JavaScript SDK의 브라우저 공개 Client ID입니다.
# 값이 없으면 애플리케이션은 지도 설정이 준비되지 않았다는 안내를 표시합니다.
VITE_NAVER_MAPS_CLIENT_ID=

# 루트 .env의 GA 설정이 있으면 우선 적용합니다. 없으면 이 파일 위치의 설정을 사용합니다.
# GA4의 선택적 브라우저 공개 측정 ID입니다. G-로 시작하는 환경별 ID를 사용합니다.
# 비어 있거나 유효하지 않으면 GA4 스크립트와 이벤트를 전송하지 않습니다.
VITE_GA_MEASUREMENT_ID=

# 선택 사항: 로컬 개발에서만 true로 설정해 GA4 DebugView로 검증합니다.
# 로컬 개발은 측정 ID와 true가 모두 있어야 수집합니다. 기본값은 false입니다.
VITE_GA_DEBUG_MODE=false

# PostHog 설정 4개는 저장소 루트 .env.example을 참고해 루트 .env에서 관리합니다.
# Vite가 해당 변수만 루트에서 읽으므로 이 파일에는 중복 설정하지 않습니다.

# 프론트 Firebase 공개 설정 5개 (npm run dev용)
# frontend/.env에 입력합니다. .env.local에 같은 키가 있으면 그 값이 우선합니다.
# Docker frontend는 이 파일 대신 루트 .env를 사용합니다. 값 변경 후 Vite 서버를 재시작합니다.
# 모두 브라우저에 공개되는 값입니다. 서비스 계정 JSON·private_key는 입력하지 않습니다.
# 개발 Firebase 프로젝트로 로컬 푸시를 검증할 때 true로 설정합니다.
# 누락된 설정이 있으면 브라우저 알림 권한을 요청하지 않습니다.
VITE_NOTIFICATION_PUSH_ENABLED=false
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 웹 앱 > firebaseConfig.apiKey
VITE_FIREBASE_API_KEY=
# firebaseConfig.projectId (백엔드 NOTIFICATION_FIREBASE_PROJECT_ID 및 JSON project_id와 동일)
VITE_FIREBASE_PROJECT_ID=
# firebaseConfig.appId
VITE_FIREBASE_APP_ID=
# firebaseConfig.messagingSenderId
VITE_FIREBASE_MESSAGING_SENDER_ID=
# 프로젝트 설정 > 클라우드 메시징 > 웹 푸시 인증서의 공개키 (서비스 계정 비공개 키 아님)
VITE_FIREBASE_VAPID_PUBLIC_KEY=

# 백엔드 알림 옵션·서비스 계정 파일 경로는 루트 .env.example의 알림 설정을 참고합니다.
# 푸시 클릭까지 검증하려면 NOTIFICATION_FRONTEND_ORIGIN에 실제 HTTPS 접속 주소가 필요합니다.
# 로그인 → 관심 등록 → 이 기기 알림 켜기 → 새 원본 공고 등록 순서로 테스트합니다.
