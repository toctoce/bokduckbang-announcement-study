# 실행 환경 (local, dev 또는 prod)
SPRING_PROFILES_ACTIVE=prod

# Loki 로그 전송 주소
LOKI_PUSH_URL=

# 로컬 모니터링의 Grafana 관리자 비밀번호 (compose.monitoring.yaml 사용 시 필수)
# HTTPS용 설정이 아니다. 실제 비밀번호는 Git이 추적하지 않는 .env에만 입력한다.
GRAFANA_ADMIN_PASSWORD=

# Primary database connection
PRIMARY_DB_HOST=db
PRIMARY_DB_PORT=5432
PRIMARY_DB_NAME=toadzip
PRIMARY_DB_USERNAME=toadzip
PRIMARY_DB_PASSWORD=

# Shared source database connection
SHARED_DB_HOST=db-shared
SHARED_DB_PORT=5432
SHARED_DB_NAME=toadzip_shared
SHARED_DB_USERNAME=toadzip
SHARED_DB_PASSWORD=

# Ports exposed on the host machine
FRONTEND_PORT=80
BACKEND_PORT=8080
MANAGEMENT_PORT=8081
LOCAL_DB_PORT=5433
LOCAL_SHARED_DB_PORT=5434

# EC2 HTTPS only: enable after first issuance (see infra/certbot/README.md).
# Keep commented for local HTTP development. DOMAIN and GID are required by HTTPS.
# TOADZIP_TLS_DOMAIN=dev.bokduckbang.com
# TOADZIP_TLS_GID=<numeric GID of the EC2 toadzip-tls group>
# COMPOSE_FILE=compose.yaml:compose.https.yaml

# Local browser origin and session-cookie transport policy
ADMIN_CORS_ALLOWED_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false

# User social login. Keep disabled until all four provider credentials are filled.
USER_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Server-only Naver Search API credentials for subway station search.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# Server-only Naver Cloud Maps credentials with Geocoding enabled for region search.
# These are separate from Naver Search credentials and the public browser SDK ID below.
# Missing credentials return 503 for that external search type; internal regions still work.
NAVER_MAPS_API_KEY_ID=
NAVER_MAPS_API_KEY=

# Public origin used by the browser. Do not add a trailing slash.
USER_OAUTH_REDIRECT_BASE_URL=http://localhost
USER_OAUTH_SUCCESS_URL=http://localhost/explore
USER_OAUTH_FAILURE_URL=http://localhost/explore?login=failed

# Local administrator bootstrap (set enabled to true only for the first run)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_LOGIN_IDENTIFIER=
ADMIN_PASSWORD=

# 공공데이터포털 일반 인증키
DATA_GO_KR_SERVICE_KEY=

# 도로명주소 개발자센터 승인키

# NAVER Maps JavaScript SDK 브라우저 공개 Client ID
VITE_NAVER_MAPS_CLIENT_ID=

# GA4 선택적 브라우저 공개 측정 ID. 환경별 값으로 빌드하며 비어 있으면 수집하지 않는다.
VITE_GA_MEASUREMENT_ID=
# 로컬 Vite에서 실제 GA 수집을 검증할 때만 true. 운영 빌드의 필수 설정이 아님.
VITE_GA_DEBUG_MODE=false

# PostHog 공개 설정은 로컬 Vite와 Docker 빌드 모두 루트에서 관리합니다.
# 선택 사항: token/host/environment가 비어 있거나 잘못되면 수집하지 않습니다.
# 개발·운영은 각각 해당 환경의 프로젝트 token을 사용합니다.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# dev 또는 prod. 로컬 검증은 dev만 허용합니다.
VITE_ANALYTICS_ENV=
# 로컬에서만 true로 켜는 개발 수집 허용 옵션. 기본값 false.
VITE_POSTHOG_LOCAL_ENABLED=false

# 공고 첨부 다운로드·미리보기 한도 (100MB = 100 MiB)
ANNOUNCEMENT_ATTACHMENT_MAX_SIZE=100MB

# 알림 로컬 테스트: 루트 .env에 입력 (Docker Compose용)
# 로컬 공통 설정: SPRING_PROFILES_ACTIVE=local, DB 비밀번호, 소셜 로그인 설정도 준비합니다.
# 알림함 테스트: PUBLISHER / MATERIALIZER를 true로 바꾸고 ACTIVATION_AT을 설정합니다.
# 실제 푸시 테스트: Firebase 설정과 HTTPS 주소 준비 후 DELIVERY / VITE_NOTIFICATION_PUSH_ENABLED도 true.
# 기본값은 외부 전송을 막기 위해 false입니다. MAINTENANCE는 보관 정리·대기열 지표용 선택 사항입니다.
NOTIFICATION_PUBLISHER_ENABLED=false
NOTIFICATION_MATERIALIZER_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_MAINTENANCE_ENABLED=false
# 최초 활성화 시각을 UTC ISO-8601로 입력하고 재시작 때도 유지합니다. 형식 예: 2026-10-14T00:00:00Z
# 관심 등록 후 새로 저장한 원본 공고로 테스트합니다. 과거 게시일·기존 공고 재저장은 대상이 아닙니다.
NOTIFICATION_ACTIVATION_AT=

# 백엔드 Firebase 설정
# Firebase 프로젝트 ID: 아래 VITE_FIREBASE_PROJECT_ID 및 JSON 내부 project_id와 동일해야 합니다.
NOTIFICATION_FIREBASE_PROJECT_ID=
# 실제로 접속 가능한 프론트 HTTPS origin만 입력합니다. 경로·쿼리 제외, 예: https://app.example.com
# 기본 http://localhost는 푸시 클릭 URL로 사용할 수 없습니다. DELIVERY=true일 때 필수입니다.
NOTIFICATION_FRONTEND_ORIGIN=
# 서비스 계정 JSON은 저장소 밖에 보관하고, 이 변수에는 호스트의 절대 경로만 입력합니다 (~ 사용 금지).
# 경로 형식 예: /Users/your-name/.config/toadzip/firebase-dev.json
# Compose 명령에 -f compose.notification-credentials.yaml을 추가하면 backend에만 읽기 전용 연결됩니다.
# 컨테이너 UID 10001이 파일을 읽을 수 있어야 합니다. JSON 내용·private_key는 환경변수에 넣지 않습니다.
NOTIFICATION_FIREBASE_CREDENTIALS_FILE=
# Docker 없이 JVM을 직접 실행할 때는 위 경로 변수를 쓰지 않고 실행 환경에 다음을 지정합니다.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-dev.json

# 프론트 Firebase 공개 설정 5개 (Docker 빌드용)
# Docker는 루트 .env, npm run dev는 frontend/.env에 입력합니다. 실행 방식에 맞는 파일을 사용하세요.
# 값 변경 후 Docker frontend를 다시 빌드하거나 Vite 개발 서버를 재시작합니다.
# 개발 Firebase 프로젝트로 로컬 푸시를 검증할 때 true로 설정합니다.
VITE_NOTIFICATION_PUSH_ENABLED=false
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 웹 앱 > firebaseConfig.apiKey
VITE_FIREBASE_API_KEY=
# firebaseConfig.projectId (위 백엔드 프로젝트 ID와 동일)
VITE_FIREBASE_PROJECT_ID=
# firebaseConfig.appId
VITE_FIREBASE_APP_ID=
# firebaseConfig.messagingSenderId
VITE_FIREBASE_MESSAGING_SENDER_ID=
# 프로젝트 설정 > 클라우드 메시징 > 웹 푸시 인증서의 공개키 (서비스 계정 비공개 키 아님)
VITE_FIREBASE_VAPID_PUBLIC_KEY=
